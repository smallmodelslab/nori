<?xml version="1.0" encoding="utf-8"?>
<!-- Nori strings (included from chrome/app/generated_resources.grd). -->
<grit-part>
  <message name="IDS_NORI_COMMAND_FOCUS_LEFT" desc="Command name shown on the Settings shortcuts page for focusing the column to the left.">
    Focus column to the left
  </message>
  <message name="IDS_NORI_COMMAND_FOCUS_RIGHT" desc="Command name shown on the Settings shortcuts page for focusing the column to the right.">
    Focus column to the right
  </message>
  <message name="IDS_NORI_COMMAND_FOCUS_UP" desc="Command name shown on the Settings shortcuts page for focusing the tab above, or the workspace above at the top of a column.">
    Focus tab or workspace above
  </message>
  <message name="IDS_NORI_COMMAND_FOCUS_DOWN" desc="Command name shown on the Settings shortcuts page for focusing the tab below, or the workspace below at the bottom of a column.">
    Focus tab or workspace below
  </message>
  <message name="IDS_NORI_COMMAND_TOGGLE_FULL_WIDTH" desc="Command name shown on the Settings shortcuts page for switching the focused column between its normal width and the full window width.">
    Toggle full-width column
  </message>
  <message name="IDS_NORI_COMMAND_POPUP" desc="Command name shown on the Settings shortcuts page for opening the centered popup with the address and site settings.">
    Open address popup
  </message>
  <message name="IDS_NORI_COMMAND_SETTINGS" desc="Command name shown on the Settings shortcuts page for opening nori's own settings page, which edits its config.toml file.">
    Open Nori settings
  </message>
  <message name="IDS_NORI_CONTENT_CONTEXT_OPENLINK_RIGHT" desc="The name of the link context menu item that opens the link in a new tab in a new column to the right of the current tab.">
    Open link in new tab to the right
  </message>
  <message name="IDS_NORI_CONTENT_CONTEXT_OPENLINK_BELOW" desc="The name of the link context menu item that opens the link in a new tab stacked below the current tab, in the same column.">
    Open link in new tab below
  </message>
  <message name="IDS_NORI_CONTENT_CONTEXT_OPENLINK_ABOVE" desc="The name of the link context menu item that opens the link in a new tab stacked above the current tab, in the same column.">
    Open link in new tab above
  </message>
</grit-part>
