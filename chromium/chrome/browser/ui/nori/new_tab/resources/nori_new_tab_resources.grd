<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/nori_new_tab_resources.h" type="rc_header">
      <emit emit_type="prepend"></emit>
    </output>
    <output filename="grit/nori_new_tab_resources_map.cc" type="resource_file_map_source" />
    <output filename="grit/nori_new_tab_resources_map.h" type="resource_map_header" />
    <output filename="nori_new_tab_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NORI_NEW_TAB_INDEX_HTML" file="index.html" type="BINDATA" resource_path="index.html" />
      <include name="IDR_NORI_NEW_TAB_CSS" file="new_tab.css" type="BINDATA" resource_path="new_tab.css" />
      <include name="IDR_NORI_NEW_TAB_JS" file="new_tab.js" type="BINDATA" resource_path="new_tab.js" />
    </includes>
  </release>
</grit>
