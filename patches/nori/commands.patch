+#if BUILDFLAG(IS_LINUX)
+// Exercise the registered browser accelerators, not just Nori's layout model:
+// a duplicate binding used to dispatch Ctrl+N to IDC_NEW_WINDOW on Linux.
+IN_PROC_BROWSER_TEST_F(BrowserCommandControllerBrowserTest,
+                       NoriColumnsStayInOneWindow) {
+  constexpr int kNoriModifiers = ui::EF_ALT_DOWN;
+  auto* shortcuts =
+      browser_shortcuts::BrowserShortcutServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(shortcuts);
+  EXPECT_EQ(shortcuts->FindCommandForAccelerator("alt+n"), IDC_NORI_FOCUS_LEFT);
+  EXPECT_EQ(shortcuts->FindCommandForAccelerator("alt+e"), IDC_NORI_FOCUS_DOWN);
+  EXPECT_EQ(shortcuts->FindCommandForAccelerator("ctrl+n"), IDC_NEW_WINDOW);
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetFocusManager();
+  auto* tabs = browser()->tab_strip_model();
+  const size_t windows = GlobalBrowserCollection::GetInstance()->GetSize();
+  const int count = tabs->count();
+  ASSERT_TRUE(focus->ProcessAccelerator(
+      ui::Accelerator(ui::VKEY_T, ui::EF_PLATFORM_ACCELERATOR)));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(tabs->count(), count + 1);
+  ASSERT_EQ(tabs->active_index(), count);
+  EXPECT_EQ(GlobalBrowserCollection::GetInstance()->GetSize(), windows);
+
+  ASSERT_TRUE(
+      focus->ProcessAccelerator(ui::Accelerator(ui::VKEY_N, kNoriModifiers)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(tabs->active_index(), count - 1);
+  EXPECT_EQ(tabs->count(), count + 1);
+  EXPECT_EQ(GlobalBrowserCollection::GetInstance()->GetSize(), windows);
+
+  ASSERT_TRUE(
+      focus->ProcessAccelerator(ui::Accelerator(ui::VKEY_I, kNoriModifiers)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(tabs->active_index(), count);
+  EXPECT_EQ(GlobalBrowserCollection::GetInstance()->GetSize(), windows);
+}
+#endif  // BUILDFLAG(IS_LINUX)
