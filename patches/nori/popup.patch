+void BrowserViewTabbedLayoutImpl::FloatTopContainerForNori(
+    ProposedLayout& top_container_layout,
+    const gfx::Rect& area,
+    float top_chrome_ratio) const {
+  top_container_layout.bounds = nori::PopupBounds(
+      area, views().toolbar->GetPreferredSize().height(), top_chrome_ratio);
+  for (auto& [child, child_layout] : top_container_layout.children) {
+    const bool is_toolbar = child == views().toolbar;
+    child_layout.bounds = is_toolbar
+                              ? gfx::Rect(top_container_layout.bounds.size())
+                              : gfx::Rect();
+    child_layout.visibility = is_toolbar;
+  }
+}
